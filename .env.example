# Optional GitHub Personal Access Token used at build time.
# It powers homepage language/repository statistics and Projects repository/contribution data.
# Without it, the site uses public data where available and falls back gracefully.
MY_TOKEN=

# Independent map service used for photo location previews.
PUBLIC_MAP_BASE_URL=https://map.lpalette.cn

# Public Hub API used by the online friend-link application form.
PUBLIC_HUB_API_BASE_URL=
